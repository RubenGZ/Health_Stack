# ── E2E environment ────────────────────────────────────────────────────────────
# Copy to .env and fill in values before running tests.
# NEVER commit .env — it is in .gitignore.

# URL of the desktop SPA (vanilla JS frontend)
DESKTOP_BASE_URL=http://localhost:3000

# URL of the mobile PWA (Vite/React frontend in dev)
# In production on the Pi this would be https://your-domain.com/mobile/
MOBILE_BASE_URL=http://localhost:5175

# URL of the FastAPI backend
API_URL=http://localhost:8000

# PostgreSQL connection string for seed/teardown scripts
# Format: postgresql://user:password@host:port/database
DB_URL=postgresql://postgres:P%40ssw0rd@localhost:5432/healthstack

# ── Test credentials ───────────────────────────────────────────────────────────
# These users are CREATED by seed.py and DELETED by teardown.py.
# Do not use real accounts.
TEST_USER_EMAIL=e2e_user@healthstack.test
TEST_USER_PASSWORD=E2eTest!2026
TEST_USER_NAME=E2E Atleta

TEST_ADMIN_EMAIL=e2e_admin@healthstack.test
TEST_ADMIN_PASSWORD=E2eAdmin!2026
TEST_ADMIN_NAME=E2E Admin
